{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundConnect Desktop",
  "version": "0.1.10",
  "identifier": "dev.soundconnect.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SoundConnect Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine/bin/RelWithDebInfo/mdr-shared.dll": "mdr-shared.dll",
      "../engine/bin/RelWithDebInfo/mdr-bt-shared.dll": "mdr-bt-shared.dll"
    },
    "licenseFile": "gen/THIRD-PARTY-LICENSES.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCNzMzRTgzOTg4NDQxQkMKUldTOFFZU1lnejV6YXh5N0VuVEpRMmFVS0YxTml4dWNkMW9KaGJETVpneWo0RVNjdkFNYzdGQzMK",
      "endpoints": [
        "https://github.com/B-Howell/soundconnect-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
